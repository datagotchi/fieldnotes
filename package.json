{
  "name": "fieldnotes",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "db": "node ./scripts/db.js"
  },
  "jest": {
    "verbose": true,
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "runScripts": "dangerously"
    },
    "moduleDirectories": [
      "src",
      "node_modules"
    ],
    "moduleNameMapper": {
      "\\.(css)$": "<rootDir>/src/app/tests/__mocks__/styleMock.js"
    },
    "testMatch": [
      "**/*.test.(js|jsx)"
    ],
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "testTimeout": 20000
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "~1.4.4",
    "eslint": "^9.39.2",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "jest": "^30.2.0",
    "jsdom": "^27.4.0",
    "morgan": "~1.9.1"
  },
  "type": "module",
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@libsql/client": "^0.15.15",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.11.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest-environment-jsdom": "^30.2.0",
    "pg": "^8.16.3",
    "supertest": "^7.1.4"
  }
}
